<mujoco model="wigglesat_6u">
  <!-- 6U CubeSat with three actuated tip-mass booms, sized to the regime of Tracy, Manchester &
       Douglas, "Ultra-Fine Pointing for Nanosatellite Telescopes With Actuated Booms" (2022).
       The paper gives no boom dimensions; these follow from its disturbance level, see
       motor_sizing.py:
         bus   12 kg, 0.366 x 0.226 x 0.100 m  ->  J = diag(0.061, 0.144, 0.185) kg m^2
         boom  0.75 m rod (30 g) + 200 g tip mass  ->  0.118 kg m^2 about its hinge
       Inertias are computed from the geoms (each geom carries its mass).
       This variant puts each motor on a torsionally compliant mount (twist about the shaft axis).
       Mount stiffness and damping are placeholders: a ~1 Hz, ~0.5 damping-ratio mode with the boom. -->
  <compiler angle="degree"/>
  <option timestep="0.0001" gravity="0 0 0" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.05 0.05 0.12" rgb2="0 0 0" width="512" height="512"/>
    <material name="bus_mat" rgba="0.85 0.85 0.9 1"/>
    <material name="cyan"    rgba="0 1 1 1"/>
  </asset>

  <default>
    <!-- armature (reflected rotor inertia) and motor damping are set from the motor preset -->
    <joint type="hinge" limited="false" damping="0" armature="0"/>
    <geom contype="0" conaffinity="0"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <default class="rod">
      <geom type="capsule" size="0.004" mass="0.03" material="cyan"/>
    </default>
    <default class="tip">
      <geom type="sphere" size="0.02" mass="0.2" material="cyan"/>
    </default>
  </default>

  <worldbody>
    <light pos="4 -4 6" dir="-1 1 -1.5" diffuse="0.9 0.9 0.9"/>

    <body name="sc_bus" pos="0 0 0">
      <freejoint name="bus_free"/>
      <geom name="bus_box" type="box" size="0.183 0.113 0.05" mass="12" material="bus_mat"/>
      <site name="imu" pos="0 0 0" size="0.005"/>

      <body name="x_motor_housing" pos="0.183 0 0">
        <joint name="x_mount_joint" axis="1 0 0" stiffness="5" damping="0.7" springref="0"/>
        <inertial pos="0 0 0" mass="0.015" diaginertia="1e-6 1e-6 1e-6"/>
        <body name="x_output_link">
          <joint name="x_motor_joint" axis="1 0 0"/>
          <inertial pos="0 0 0" mass="0.005" diaginertia="1e-7 1e-7 1e-7"/>
          <body name="x_arm_link">
            <geom class="rod" fromto="0 0 0 0 0 0.75"/>
            <geom class="tip" pos="0 0 0.75"/>
          </body>
        </body>
      </body>

      <body name="y_motor_housing" pos="0 0.113 0">
        <joint name="y_mount_joint" axis="0 1 0" stiffness="5" damping="0.7" springref="0"/>
        <inertial pos="0 0 0" mass="0.015" diaginertia="1e-6 1e-6 1e-6"/>
        <body name="y_output_link">
          <joint name="y_motor_joint" axis="0 1 0"/>
          <inertial pos="0 0 0" mass="0.005" diaginertia="1e-7 1e-7 1e-7"/>
          <body name="y_arm_link">
            <geom class="rod" fromto="0 0 0 0 0 0.75"/>
            <geom class="tip" pos="0 0 0.75"/>
          </body>
        </body>
      </body>

      <body name="z_motor_housing" pos="0 0 0.05">
        <joint name="z_mount_joint" axis="0 0 1" stiffness="5" damping="0.7" springref="0"/>
        <inertial pos="0 0 0" mass="0.015" diaginertia="1e-6 1e-6 1e-6"/>
        <body name="z_output_link">
          <joint name="z_motor_joint" axis="0 0 1"/>
          <inertial pos="0 0 0" mass="0.005" diaginertia="1e-7 1e-7 1e-7"/>
          <body name="z_arm_link">
            <geom class="rod" fromto="0 0 0 -0.75 0 0"/>
            <geom class="tip" pos="-0.75 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_x" joint="x_motor_joint" gear="1"/>
    <motor name="act_y" joint="y_motor_joint" gear="1"/>
    <motor name="act_z" joint="z_motor_joint" gear="1"/>
  </actuator>

  <sensor>
    <gyro      name="gyro" site="imu"/>
    <framequat name="quat" objtype="site" objname="imu"/>
    <jointpos  name="q_x"  joint="x_mount_joint"/>
    <jointpos  name="q_y"  joint="y_mount_joint"/>
    <jointpos  name="q_z"  joint="z_mount_joint"/>
    <jointvel  name="qd_x" joint="x_mount_joint"/>
    <jointvel  name="qd_y" joint="y_mount_joint"/>
    <jointvel  name="qd_z" joint="z_mount_joint"/>
  </sensor>
</mujoco>
